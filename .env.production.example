# Production example. Copy to your deployment environment and replace values.

PORT=3000
GIN_MODE=release
TZ=Asia/Shanghai

# Public HTTPS origin used for OAuth callbacks, passkeys, payment returns, and video proxy URLs.
SERVER_ADDRESS=https://www.lioniuiu.top

# Restrict browser CORS in production. Use comma-separated origins.
CORS_ALLOW_ORIGINS=https://www.lioniuiu.top,https://lioniuiu.top

# Reverse proxy addresses that are allowed to set X-Forwarded-For.
# For Docker bridge, keep the private Docker subnet you actually use.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# You said MySQL will be configured separately. Example:
# SQL_DSN=user:password@tcp(mysql-host:3306)/new-api?parseTime=true&charset=utf8mb4&loc=Local

# Redis is strongly recommended in production.
# REDIS_CONN_STRING=redis://:change-me@redis-host:6379/0

ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
UPDATE_TASK=true
MEMORY_CACHE_ENABLED=true

# Must be a long random string in production.
SESSION_SECRET=change-this-to-a-long-random-string

# Recommended request limits. Tune for your workload.
RELAY_TIMEOUT=0
STREAMING_TIMEOUT=300
MAX_REQUEST_BODY_MB=128
MAX_FILE_DOWNLOAD_MB=64

NODE_TYPE=master
NODE_NAME=new-api-prod-1
